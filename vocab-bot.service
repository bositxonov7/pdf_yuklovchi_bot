[Unit]
Description=Vocabulary PDF Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vocab_bot
ExecStart=/opt/vocab_bot/venv/bin/python bot.py
Restart=always
RestartSec=10
Environment=TZ=Asia/Tashkent
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
